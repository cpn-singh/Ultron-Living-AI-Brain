{
  "name": "ultron-desktop",
  "productName": "ULTRON",
  "private": true,
  "version": "1.0.0",
  "description": "ULTRON — Cybernetic Living AI Brain",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "vite build && electron electron/main.cjs",
    "electron:dev": "vite build && electron electron/main.cjs",
    "build:icons": "node scripts/create_icon.cjs",
    "build:backend": "pyinstaller --onefile --noconsole --name ultron_engine server/app.py --distpath server",
    "pack": "electron-builder --dir",
    "predist": "node scripts/create_icon.cjs",
    "dist": "vite build && electron-builder --win nsis",
    "dist:all": "vite build && electron-builder --win nsis portable",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:full": "npm run build:backend && vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app-launcher": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "pg": "^8.13.1",
    "tailwind-merge": "^2.2.1",
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  },
  "build": {
    "appId": "com.ultron.livingbrain",
    "productName": "ULTRON",
    "copyright": "Copyright © 2026 ULTRON AI",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "server/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/*.pyc",
          "!**/__pycache__"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ULTRON",
      "uninstallDisplayName": "ULTRON Living AI Brain",
      "deleteAppDataOnUninstall": false
    }
  }
}
